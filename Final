class ChessGUI:
    def __init__(self):
        self.player = Player("unknown")
        self.window = tk.Tk()
        self.window.title("Chess Opening Helper")
        self.window.geometry("520x500")
        tk.Label(self.window, text="Chess Opening Helper", font=("Arial", 16)).pack(pady=10)
        tk.Label(self.window, text="White or Black PIECES not race:").pack()
        self.role_entry = tk.Entry(self.window)
        self.role_entry.pack()
        tk.Label(self.window, text="First Move:").pack()
        self.move_entry = tk.Entry(self.window)
        self.move_entry.pack()
        tk.Label(self.window, text="Second Move:").pack()
        self.second_entry = tk.Entry(self.window)
        self.second_entry.pack()
#buttons here
        tk.Button(self.window, text="Enter", command=self.process).pack(pady=10)
        tk.Button(self.window, text="Show Moves", command=self.show_moves).pack(pady=5)
        tk.Button(self.window, text="Restart", command=self.reset).pack(pady=5)
        self.output = tk.StringVar()
        self.output.set("enter info above")
        tk.Label(self.window, textvariable=self.output, wraplength=420).pack(pady=20)
        self.window.mainloop()
    def process(self):
        try:
            role = self.role_entry.get().lower().strip()
            move = self.move_entry.get().lower().strip()
            second = self.second_entry.get().lower().strip()
            if role == "white":
                self.player = WPlayer("white")
            elif role == "black":
                self.player = BPlayer("black")
            else:
                self.output.set("Type White or Black (CHESS PIECE COLOR)")
                return
            self.player.add_move(move)
            if second:
                self.player.add_move(second)
            message = ""
            if role == "white":
                if move in white_openings:
                    message = f"THATS A GREAT OPENING. I would predict black will play: {black_responses.get(move, 'unknown')}"
                else: message = "thats a interesting move...its a little uncommon sorry."
            if second:
                if second in white_followups:
                    message += f"\n{white_followups[second]}"
                else:
                    message += "\nThe best move would be to develop your pieces toward the center."
            elif role == "black":
                if move in black_responses:
                    message = f"Best reponse: {black_responses[move]}"
                else:
                    message = "Play the moves Nf6 or d5 in order to have a very solid opening position."
                if second:
                    if second in black_responses:
                        message += f"\nBest follow up: {black_responses[second]}"
                    else:
                        message += "\nDevelop the pieces towards the center for a powerful defensive and attacking position."
            self.output.set(message)
        except Exception as e:
            messagebox.showerror("Error", str(e))
    def show_moves(self):
        moves_str = ",".join(self.player.moves) if self.player.moves else "NO moves have been made yet..."
        messagebox.showinfo("Moves Player", f"Player ({self.player.color}): {moves_str}")
    def reset(self):
        self.player.moves.clear()
        self.role_entry.delete(0, tk.END)
        self.move_entry.delete(0, tk.END)
        self.second_entry.delete(0, tk.END)
        self.output.set("reset has been completed now all moves have been reset.")
